# Ignore everything
/*

# Keep .gitignore
!/.gitignore

# Keep Snakefile
!/Snakefile

# Keep README.md
!/README.md


# Keep scripts directory
!/scripts/

# Ignore everything inside scripts
/scripts/*

# Allow only selected scripts
!/scripts/permanova.R
!/scripts/permanova-to-latex.py


# Keep provenance/environment directory 
!/provenance/
!/provenance/environment/ 

# Ignore everything inside provenance/environment
/provenance/environment/*

# Allow only selected provenance/environment
!/provenance/environment/resolved.yml

